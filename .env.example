# Copie para .env.local (local) ou cadastre em Vercel > Settings > Environment Variables.
# NUNCA coloque estas chaves no código nem no GitHub.

# Chave de API da PixxBlack: painel > Integrações > "Gerar chave de API"  (começa com pxb_live_)
PIXXBLACK_API_KEY=pxb_live_xxxxxxxxxxxxxxxx

# Segredo de assinatura do webhook (whsec_...): painel > Integrações > Webhooks (aparece uma única vez)
PIXXBLACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Opcional (padrão: https://pixxblack.com/api/v1)
# PIXXBLACK_BASE_URL=https://pixxblack.com/api/v1
