# Copie para .env.local (local) ou cadastre em Vercel > Settings > Environment Variables.
# NUNCA coloque a chave no código nem no GitHub.
PINGUPAG_API_KEY=pingupag_xxxxxxxxxxxxxxxx
# Opcional (padrão: https://pagamento-processador.org.ua)
# PINGUPAG_BASE_URL=https://pagamento-processador.org.ua

# ---- Rastreamento (servidor) ----
# Token da API da UTMify: UTMify > Integrações > Webhooks > Credenciais de API > Adicionar Credencial
UTMIFY_API_TOKEN=
# Token da API de Conversões da Meta: Gerenciador de Eventos > seu Pixel > Configurações > API de Conversões > Gerar token de acesso
META_CAPI_TOKEN=
META_PIXEL_ID=1125182217062286
# Para testar na Meta sem sujar os dados: código da aba "Testar eventos" (remova depois)
# META_TEST_EVENT_CODE=TEST12345
# Taxa do gateway para a UTMify calcular o lucro (opcional)
# PINGUPAG_FEE_PERCENT=0
# PINGUPAG_FEE_FIXED_CENTS=0
# Segredo para assinar o link do webhook (opcional; padrão = PINGUPAG_API_KEY)
# WEBHOOK_SECRET=
